# ── Secrets & local config — NEVER commit ──────────────────────
.env
*.env
!.env.example
*.tfvars
!*.tfvars.example
.databrickscfg
*.pem
*.key

# ── Terraform ───────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
# note: .terraform.lock.hcl IS committed (dependency lock file)

# ── Databricks ──────────────────────────────────────────────────
.databricks/

# ── Data & checkpoints — never commit data, only code ──────────
data/
checkpoints/
*.json.gz
*.parquet

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# ── IDE / OS ────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
