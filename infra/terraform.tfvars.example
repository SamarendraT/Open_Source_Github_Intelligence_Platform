# Copy to terraform.tfvars (gitignored) and fill in. NEVER commit terraform.tfvars.

subscription_id = "00000000-0000-0000-0000-000000000000" # az account show --query id -o tsv
location        = "REPLACE_ME"                            # a region your allowed-regions policy permits (see README pre-flight)
unique_suffix   = "abcd"                                  # 3-6 lowercase alphanumerics, globally unique

# Leave false unless your pre-flight `az ad app create` test succeeds and you want
# the Key Vault secret-scope demo. Managed identity (access connector) is the default.
create_service_principal = false
